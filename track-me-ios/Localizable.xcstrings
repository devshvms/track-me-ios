    "On iPhone, set Location access to Always. Also check Low Power Mode and Background App Refresh in Settings.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle auf dem iPhone den Standortzugriff auf Immer. Prüfe auch Stromsparmodus und Hintergrundaktualisierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone, set Location access to Always. Also check Low Power Mode and Background App Refresh in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPhone, configura la ubicación como Siempre. Revisa también el modo de bajo consumo y la actualización en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone, réglez l'accès à la position sur Toujours. Vérifiez aussi le mode économie d'énergie et l'actualisation en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone में स्थान एक्सेस को हमेशा पर सेट करें। लो पावर मोड और बैकग्राउंड ऐप रिफ्रेश भी जांचें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで位置情報のアクセスを「常に許可」にします。低電力モードとAppのバックグラウンド更新も確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上将位置访问设为始终允许，并检查低电量模式和后台 App 刷新。"
          }
        }
      }
    },
