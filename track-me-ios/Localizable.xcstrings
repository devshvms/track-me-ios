    "Approaching the limit. Your ride will split automatically at 9,000 points.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approaching the limit. Your ride will split automatically at 9,000 points."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit nähert sich. Ihre Fahrt wird bei 9.000 Punkten automatisch geteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acercándose al límite. Su viaje se dividirá automáticamente a los 9,000 puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approche de la limite. Votre trajet sera automatiquement scindé à 9 000 points."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा के करीब। आपकी सवारी 9,000 बिंदुओं पर स्वचालित रूप से विभाजित हो जाएगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限に近づいています。ライドは9,000ポイントで自動的に分割されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接近限制。您的骑行将在9,000个点自动拆分。"
          }
        }
      }
    },
