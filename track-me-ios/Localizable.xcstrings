    "Share your live location with friends and family. Your location will be updated even if you haven't started recording a ride yet.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile deinen Live-Standort mit Freunden und Familie. Dein Standort wird auch aktualisiert, wenn du noch keine Fahrt aufgezeichnet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu ubicación en vivo con amigos y familiares. Tu ubicación se actualizará aunque todavía no hayas empezado a grabar un recorrido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre position en direct avec vos proches. Votre position sera mise à jour même si vous n’avez pas encore commencé à enregistrer un trajet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्तों और परिवार के साथ अपना लाइव स्थान साझा करें। आपने अभी राइड रिकॉर्ड करना शुरू न किया हो, तब भी आपका स्थान अपडेट होगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友人や家族と現在地を共有できます。ライドの記録を始めていなくても位置情報は更新されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与亲友分享实时位置。即使尚未开始记录骑行，位置也会继续更新。"
          }
        }
      }
    },
    "Sharing will automatically stop when you finish your ride.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe endet automatisch, wenn du die Fahrt beendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso compartido se detendrá automáticamente cuando termines el recorrido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage s’arrêtera automatiquement lorsque vous terminerez le trajet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राइड समाप्त करने पर शेयरिंग अपने आप बंद हो जाएगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライドを終了すると共有は自動的に停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
