    "Groups are end-to-end encrypted and expire on their own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen sind Ende-zu-Ende-verschlüsselt und laufen von selbst ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups are end-to-end encrypted and expire on their own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grupos están cifrados de extremo a extremo y caducan solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes sont chiffrés de bout en bout et expirent d'eux-mêmes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्रुप एंड-टू-एंड एन्क्रिप्टेड होते हैं और अपने आप समाप्त हो जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループはエンドツーエンドで暗号化され、自動的に期限切れになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组端到端加密，并会自动过期。"
          }
        }
      }
    },
