    "🛡️ Offline Tracking Shield Active • Route Safely Recording" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ Offline-Aufzeichnung aktiv • Route wird sicher aufgezeichnet" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ Protección sin conexión activa • Ruta grabándose de forma segura" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ Enregistrement hors ligne actif • Trajet enregistré en sécurité" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ ऑफ़लाइन ट्रैकिंग शील्ड सक्रिय • रूट सुरक्षित रूप से रिकॉर्ड हो रहा है" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ オフライン記録シールドが有効 • ルートを安全に記録中" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ 离线记录保护已启用 • 正在安全记录路线" } }
      }
    },
    "🛡️ Offline Tracking Shield • Ready to Record Locally" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ Offline-Aufzeichnungsschutz • Bereit für lokale Aufzeichnung" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ Protección de registro sin conexión • Listo para grabar localmente" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ Protection d’enregistrement hors ligne • Prêt à enregistrer localement" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ ऑफ़लाइन ट्रैकिंग शील्ड • स्थानीय रूप से रिकॉर्ड करने के लिए तैयार" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ オフライン記録シールド • ローカル記録の準備完了" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "🛡️ 离线记录保护 • 已准备好本地记录" } }
      }
    },
    "TrackMe records your route locally first and needs location access while you are moving. Allowing Always access lets an active track continue when your phone is locked." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "TrackMe zeichnet deine Route zuerst lokal auf und benötigt während der Bewegung Standortzugriff. Mit Immer kann eine aktive Aufzeichnung bei gesperrtem iPhone fortgesetzt werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "TrackMe registra primero tu ruta localmente y necesita acceso a la ubicación mientras te mueves. Permitir Siempre mantiene el registro activo cuando el teléfono está bloqueado." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "TrackMe enregistre d’abord votre trajet localement et a besoin de votre position pendant vos déplacements. L’accès Toujours permet de continuer un trajet actif lorsque l’iPhone est verrouillé." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "TrackMe पहले आपका रूट स्थानीय रूप से रिकॉर्ड करता है और चलते समय स्थान एक्सेस चाहता है। Always अनुमति देने पर फोन लॉक होने पर भी सक्रिय ट्रैक जारी रहता है।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "TrackMeはまずルートを端末に記録し、移動中は位置情報へのアクセスを必要とします。「常に許可」すると、iPhoneがロック中でも記録を続けられます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "TrackMe 会先在本地记录路线，移动时需要位置访问权限。允许始终访问后，即使手机锁定，正在进行的记录也会继续。" } }
      }
    },
    "Last synced: %@" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zuletzt synchronisiert: %@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Última sincronización: %@" } },
