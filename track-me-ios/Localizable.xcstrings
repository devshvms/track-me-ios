    "Dynamically pauses the moving timer at traffic signals or stops based on activity speed.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert den Bewegungstimer an Ampeln oder Stopps dynamisch anhand der Aktivitätsgeschwindigkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa dinámicamente el temporizador en semáforos o paradas según la velocidad de actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en pause le minuteur aux feux ou arrêts selon la vitesse de l’activité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गतिविधि की गति के आधार पर सिग्नल या रुकने पर टाइमर को रोकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "活動速度に基づき、信号や停止時に移動タイマーを動的に一時停止します。"
