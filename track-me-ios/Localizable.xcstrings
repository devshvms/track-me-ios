    "This tells the people in this group. It does not contact emergency services. They'll see it when their app next syncs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies teilt es den Personen in dieser Gruppe mit. Es kontaktiert keine Rettungsdienste. Sie sehen es bei der nächsten Synchronisierung ihrer App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tells the people in this group. It does not contact emergency services. They'll see it when their app next syncs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se lo comunica a las personas del grupo. No contacta con los servicios de emergencia. Lo verán cuando su app se sincronice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela informe les personnes de ce groupe. Aucun service d’urgence n’est contacté. Elles le verront lors de la prochaine synchronisation de leur app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस ग्रुप के लोगों को बताता है। यह आपातकालीन सेवाओं से संपर्क नहीं करता। उनकी ऐप अगली बार सिंक होने पर वे इसे देखेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはグループ内の人に伝えるものです。緊急サービスには連絡しません。相手のアプリが次に同期したときに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会告知群组成员，但不会联系紧急服务。他们会在应用下次同步时看到。"
          }
        }
      }
    },
