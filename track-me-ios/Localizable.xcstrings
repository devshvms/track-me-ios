    "Welcome aboard. Every journey starts with one — nicely done.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen an Bord. Jede Reise beginnt mit der ersten – gut gemacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenido. Todo viaje empieza por el primero: ¡bien hecho!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue. Chaque aventure commence par un premier trajet — bravo !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्वागत है। हर सफ़र पहली राइड से शुरू होता है — बढ़िया!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ようこそ。すべては最初の一歩から。お疲れさまでした！"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎加入。每段旅程都始于第一次——做得好！"
          }
        }
      }
    },
