            "value": "Willkommen zurück bei %1$@ nach %2$@ Tagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué bueno volver a %1$@ después de %2$@ días."
          }
        },
        "fr": {
