            "value": "पहली राइड सेव हो गई!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めてのライドを保存しました！"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存首次骑行！"
          }
        }
      }
    },
    "For accurate routes, keep Precise Location enabled for TrackMe and avoid Low Power Mode during long rides.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für genaue Routen muss „Genauer Standort“ für TrackMe aktiviert bleiben. Vermeide bei langen Touren den Stromsparmodus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For accurate routes, keep Precise Location enabled for TrackMe and avoid Low Power Mode during long rides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para obtener rutas precisas, mantén activada la ubicación precisa para TrackMe y evita el modo de bajo consumo en rutas largas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour des parcours précis, gardez la localisation précise activée pour TrackMe et évitez le mode économie d'énergie pendant les longs trajets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सटीक मार्गों के लिए TrackMe हेतु सटीक लोकेशन चालू रखें और लंबी राइड के दौरान लो पावर मोड से बचें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確なルートのため、TrackMe の「正確な位置情報」をオンにし、長時間の記録では低電力モードを避けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为确保路线准确，请为 TrackMe 开启“精确位置”，并在长途行程中避免使用低电量模式。"
          }
        }
      }
    },
    "For group start reminders and important ride status alerts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Erinnerungen an Gruppenstarts und wichtige Hinweise zum Aufzeichnungsstatus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For group start reminders and important ride status alerts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recordatorios del inicio de grupos y avisos importantes sobre el estado de la ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les rappels de départ de groupe et les alertes importantes sur l'état du trajet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्रुप शुरू होने की याद दिलाने और राइड की स्थिति से जुड़ी महत्वपूर्ण सूचनाओं के लिए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ開始のリマインダーや、記録状態に関する重要なお知らせのために使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于群组出发提醒和重要的行程状态通知。"
          }
        }
      }
    },
    "For your security, please sign out and sign back in, then try deleting your account again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Sicherheitsgründen melden Sie sich bitte ab und wieder an und versuchen Sie dann erneut, Ihr Konto zu löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your security, please sign out and sign back in, then try deleting your account again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por su seguridad, cierre la sesión y vuelva a iniciarla, luego intente eliminar su cuenta nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour votre sécurité, veuillez vous déconnecter et vous reconnecter, puis réessayer de supprimer votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सुरक्षा के लिए, कृपया साइन आउट करें और वापस साइन इन करें, फिर अपना खाता हटाने का प्रयास करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティのため、一度サインアウトしてから再度サインインし、アカウントの削除をもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了您的安全，请注销并重新登录，然后再尝试删除您的帐户。"
          }
        }
      }
    },
