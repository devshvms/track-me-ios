        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Activez l’accès à la position dans Réglages pour commencer l’enregistrement." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "ट्रैकिंग शुरू करने के लिए सेटिंग्स में स्थान की अनुमति दें।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "記録を開始するには「設定」で位置情報へのアクセスを許可してください。" } },
