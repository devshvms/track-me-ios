        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí. La grabación es local. Solo se necesita conexión para sincronizar, compartir en vivo y SOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui. L'enregistrement est local. Une connexion est nécessaire uniquement pour la synchronisation, le partage en direct et le SOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हां। रिकॉर्डिंग पहले स्थानीय होती है। कनेक्शन केवल क्लाउड सिंक, लाइव शेयर और SOS के लिए चाहिए।"
          }
        },
        "ja": {
