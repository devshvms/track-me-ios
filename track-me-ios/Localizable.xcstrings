    "No rides match your selected filter criteria or no rides recorded yet." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine Fahrt entspricht den Filtern oder es wurden noch keine Fahrten aufgezeichnet." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ningún recorrido coincide con los filtros o todavía no se ha grabado ninguno." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun trajet ne correspond aux filtres ou aucun trajet n’a encore été enregistré." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके चुने फ़िल्टर से कोई राइड मेल नहीं खाती या अभी कोई राइड रिकॉर्ड नहीं हुई।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したフィルターに一致するライドがないか、まだ記録されていません。" } },
