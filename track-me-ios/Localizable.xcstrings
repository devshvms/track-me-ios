    "Unable to connect to live share service. Please check your network connection.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann keine Verbindung zum Live-Sharing-Dienst hergestellt werden. Bitte überprüfen Sie Ihre Netzwerkverbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar al servicio de uso compartido en vivo. Por favor, compruebe su conexión de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter au service de partage en direct. Veuillez vérifier votre connexion réseau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव शेयर सेवा से कनेक्ट करने में असमर्थ। कृपया अपना नेटवर्क कनेक्शन जांचें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ共有サービスに接続できません。ネットワーク接続を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到实时共享服务。请检查您的网络连接。"
          }
        }
      }
    },
    "Unable to reach live share server. Please check your internet connection and try again.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Live-Sharing-Server ist nicht erreichbar. Bitte überprüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
