    "Location is requested after Start so TrackMe can record your route.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort wird erst nach Start angefordert, damit TrackMe deine Route aufzeichnen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación se solicita después de Iniciar para que TrackMe pueda registrar tu ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est demandée après Démarrer afin que TrackMe puisse enregistrer votre itinéraire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TrackMe आपके मार्ग को रिकॉर्ड कर सके, इसलिए स्थान की अनुमति शुरू करने के बाद माँगी जाती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TrackMeがルートを記録できるよう、位置情報は開始後に求められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击开始后才会请求位置权限，以便 TrackMe 记录你的路线。"
