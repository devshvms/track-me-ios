    "Anyone with the link can see it until the session expires. Only the signed-in owner can start, update, or stop the session.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Person mit dem Link kann ihn bis zum Ablauf sehen. Nur der angemeldete Besitzer kann die Sitzung starten, ändern oder beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with the link can see it until the session expires. Only the signed-in owner can start, update, or stop the session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera con el enlace puede verlo hasta que expire la sesión. Solo el propietario conectado puede iniciarla, actualizarla o detenerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne ayant le lien peut le voir jusqu'à l'expiration. Seul le propriétaire connecté peut démarrer, modifier ou arrêter la session."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक वाला कोई भी व्यक्ति सत्र समाप्त होने तक इसे देख सकता है। केवल साइन-इन मालिक इसे शुरू, बदल या रोक सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを知っている人はセッションの期限まで閲覧できます。開始、更新、停止できるのはサインインした所有者だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拥有链接的人都能在会话到期前查看。只有已登录的所有者能开始、更新或停止会话。"
          }
        }
      }
    },
