        "hi" : { "stringUnit" : { "state" : "translated", "value" : "TrackMe राइड" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "TrackMeライド" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "TrackMe 骑行" } }
      }
    },
    "Time: %@  |  Dist: %@ km" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeit: %@  |  Strecke: %@ km" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tiempo: %@  |  Dist.: %@ km" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Temps : %@  |  Dist. : %@ km" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "समय: %@  |  दूरी: %@ किमी" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "時間: %@  |  距離: %@ km" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "时间：%@  |  距离：%@ 公里" } }
      }
    },
    "Sharing will automatically stop when you finish your ride." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Freigabe endet automatisch, wenn du die Fahrt beendest." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El uso compartido se detendrá automáticamente cuando termines el recorrido." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le partage s’arrêtera automatiquement lorsque vous terminerez le trajet." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "राइड समाप्त करने पर शेयरिंग अपने आप बंद हो जाएगी।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ライドを終了すると共有は自動的に停止します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束骑行后，共享会自动停止。" } }
      }
    },
    "Mode" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Modus" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Modo" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Mode" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मोड" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "モード" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模式" } }
      }
    },
    "Hours" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Stunden" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Horas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Heures" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "घंटे" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "時間" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "小时" } }
      }
    },
    "Minutes" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Minuten" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Minutos" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Minutes" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मिनट" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "分" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "分钟" } }
      }
    },
    "h" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Std." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "h" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "h" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "घं" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "時間" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "小时" } }
      }
    },
    "m" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Min." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "min" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "min" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मि" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "分" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "分钟" } }
      }
    },
    "Request a comprehensive archive of your synchronized ride history (GPX files & JSON metadata). The ZIP is assembled when you download it and expires six hours after retrieval, or after 48 hours if untouched." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Fordere ein vollständiges Archiv deines synchronisierten Fahrtverlaufs an (GPX-Dateien und JSON-Metadaten). Die ZIP-Datei wird beim Download erstellt und läuft sechs Stunden danach oder nach 48 Stunden ohne Zugriff ab." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Solicita un archivo completo de tu historial sincronizado (archivos GPX y metadatos JSON). El ZIP se prepara al descargarlo y caduca seis horas después o tras 48 horas sin acceso." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Demandez une archive complète de votre historique synchronisé (fichiers GPX et métadonnées JSON). Le ZIP est créé lors du téléchargement et expire six heures après, ou après 48 heures sans accès." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपने सिंक किए गए राइड इतिहास का पूरा आर्काइव मांगें (GPX फ़ाइलें और JSON मेटाडेटा)। ZIP डाउनलोड करते समय तैयार होती है और प्राप्ति के छह घंटे बाद या 48 घंटे तक बिना उपयोग के समाप्त हो जाती है।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "同期済みのライド履歴全体のアーカイブ（GPXファイルとJSONメタデータ）をリクエストできます。ZIPはダウンロード時に作成され、取得から6時間後、または未取得のまま48時間後に期限切れになります。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请求同步骑行记录的完整存档（GPX 文件和 JSON 元数据）。ZIP 会在下载时生成，获取后六小时或未使用 48 小时后过期。" } }
      }
    },
    "Help us improve by securely sharing anonymous app usage data (e.g., ride durations, crashes). No identifiable personal data is ever shared." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Hilf uns, die App zu verbessern, indem du anonymisierte Nutzungsdaten sicher teilst (z. B. Fahrtdauer und Abstürze). Es werden niemals personenbezogene Daten geteilt." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ayúdanos a mejorar compartiendo de forma segura datos anónimos de uso (por ejemplo, duración de recorridos y fallos). Nunca se comparten datos personales identificables." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aidez-nous à améliorer l’app en partageant de manière sécurisée des données d’utilisation anonymes (par exemple la durée des trajets et les plantages). Aucune donnée personnelle identifiable n’est partagée." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अनाम ऐप उपयोग डेटा सुरक्षित रूप से साझा करके हमें सुधारने में मदद करें (जैसे राइड अवधि और क्रैश)। पहचान योग्य व्यक्तिगत डेटा कभी साझा नहीं किया जाता।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "匿名のアプリ利用データ（ライド時間やクラッシュなど）を安全に共有して改善にご協力ください。個人を特定できるデータは共有されません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安全地分享匿名应用使用数据（例如骑行时长和崩溃信息），帮助我们改进。我们不会分享任何可识别个人身份的数据。" } }
      }
    },
    "Turn on to save raw, uncompressed data. Skipping processing increases storage and keeps glitches." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiviere diese Option, um rohe, unkomprimierte Daten zu speichern. Ohne Verarbeitung wird mehr Speicher benötigt und Störungen bleiben erhalten." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Actívalo para guardar datos sin procesar y sin comprimir. Omitir el procesamiento usa más almacenamiento y conserva los errores." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Activez cette option pour conserver les données brutes et non compressées. Ignorer le traitement augmente le stockage nécessaire et conserve les anomalies." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "कच्चा, बिना कंप्रेस किया डेटा सेव करने के लिए चालू करें। प्रोसेसिंग छोड़ने से अधिक स्टोरेज लगेगा और गड़बड़ियां बनी रहेंगी।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "未圧縮の生データを保存するにはオンにします。処理を省くとストレージ使用量が増え、異常値が残ります。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启后会保存原始的未压缩数据。跳过处理会增加存储用量并保留异常数据。" } }
      }
    },
    "Signing out will clear all your synced rides from this phone's local history. They will remain safely in the cloud, and any new rides will be saved locally. Are you sure you want to sign out?" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Beim Abmelden werden alle synchronisierten Fahrten aus dem Verlauf dieses iPhones entfernt. Sie bleiben sicher in der Cloud, neue Fahrten werden lokal gespeichert. Möchtest du dich wirklich abmelden?" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Al cerrar sesión se eliminarán del historial local de este teléfono todos tus recorridos sincronizados. Seguirán seguros en la nube y los nuevos se guardarán localmente. ¿Quieres cerrar sesión?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La déconnexion supprimera tous vos trajets synchronisés de l’historique local de cet iPhone. Ils resteront dans le cloud et les nouveaux trajets seront enregistrés localement. Voulez-vous vous déconnecter ?" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "साइन आउट करने से इस फोन के स्थानीय इतिहास से आपकी सभी सिंक राइड हट जाएंगी। वे क्लाउड में सुरक्षित रहेंगी और नई राइड स्थानीय रूप से सेव होंगी। क्या आप साइन आउट करना चाहते हैं?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サインアウトすると、このiPhoneのローカル履歴から同期済みのライドがすべて削除されます。ライドはクラウドに安全に残り、新しいライドは端末に保存されます。サインアウトしますか？" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "退出登录会从此手机的本地记录中清除所有已同步的骑行。它们仍会安全保存在云端，新骑行会保存在本地。确定要退出登录吗？" } }
      }
    },
    "Are you sure you want to delete all your synced rides from the cloud? This action cannot be undone." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Möchtest du wirklich alle synchronisierten Fahrten aus der Cloud löschen? Diese Aktion kann nicht rückgängig gemacht werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Seguro que quieres eliminar de la nube todos tus recorridos sincronizados? Esta acción no se puede deshacer." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Voulez-vous vraiment supprimer de l’app tous vos trajets synchronisés dans le cloud ? Cette action est irréversible." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "क्या आप क्लाउड से अपनी सभी सिंक राइड हटाना चाहते हैं? यह कार्रवाई वापस नहीं की जा सकती।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "同期済みのライドをすべてクラウドから削除しますか？この操作は取り消せません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "确定要从云端删除所有已同步的骑行吗？此操作无法撤销。" } }
      }
    },
    "This is a permanent action. Your account and all cloud data will be deleted forever." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dies ist dauerhaft. Dein Konto und alle Cloud-Daten werden endgültig gelöscht." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta acción es permanente. Tu cuenta y todos los datos de la nube se eliminarán para siempre." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette action est définitive. Votre compte et toutes vos données cloud seront supprimés pour toujours." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह स्थायी कार्रवाई है। आपका खाता और क्लाउड का सारा डेटा हमेशा के लिए हटा दिया जाएगा।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この操作は取り消せません。アカウントとすべてのクラウドデータが完全に削除されます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此操作永久有效。您的账户和所有云数据将被永久删除。" } }
      }
    },
    "Your archive is ready. Download it from Account Management when you are ready to share or save it. The link expires six hours after retrieval, or after 48 hours if untouched." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dein Archiv ist bereit. Lade es in der Kontoverwaltung herunter, wenn du es teilen oder speichern möchtest. Der Link läuft sechs Stunden nach Abruf oder nach 48 Stunden ohne Zugriff ab." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu archivo está listo. Descárgalo desde Administración de la cuenta cuando quieras compartirlo o guardarlo. El enlace caduca seis horas después de obtenerlo o tras 48 horas sin usarlo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Votre archive est prête. Téléchargez-la depuis Gestion du compte lorsque vous souhaitez la partager ou l’enregistrer. Le lien expire six heures après son obtention ou après 48 heures sans accès." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपका आर्काइव तैयार है। शेयर या सेव करने के लिए तैयार होने पर इसे खाता प्रबंधन से डाउनलोड करें। लिंक प्राप्ति के छह घंटे बाद या 48 घंटे तक बिना उपयोग के समाप्त हो जाता है।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アーカイブの準備ができました。共有または保存する準備ができたら、アカウント管理からダウンロードしてください。リンクは取得から6時間後、または未取得のまま48時間後に期限切れになります。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "您的存档已准备就绪。准备好分享或保存时，请从账户管理中下载。链接在获取后六小时或未使用 48 小时后过期。" } }
      }
    },
    "Sign in before downloading your archive." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Melde dich vor dem Herunterladen deines Archivs an." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Inicia sesión antes de descargar tu archivo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez-vous avant de télécharger votre archive." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आर्काइव डाउनलोड करने से पहले साइन इन करें।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アーカイブをダウンロードする前にサインインしてください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载存档前请先登录。" } }
      }
    },
    "The export did not include a secure download link. Request a new archive." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Export enthält keinen sicheren Download-Link. Fordere ein neues Archiv an." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La exportación no incluyó un enlace de descarga seguro. Solicita un archivo nuevo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’exportation ne contient pas de lien de téléchargement sécurisé. Demandez une nouvelle archive." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "एक्सपोर्ट में सुरक्षित डाउनलोड लिंक नहीं था। नया आर्काइव मांगें।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "エクスポートに安全なダウンロードリンクがありません。新しいアーカイブをリクエストしてください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导出中没有安全的下载链接。请重新请求存档。" } }
      }
    },
    "The archive download returned an unexpected response." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Archiv-Download hat eine unerwartete Antwort zurückgegeben." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La descarga del archivo devolvió una respuesta inesperada." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le téléchargement de l’archive a renvoyé une réponse inattendue." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आर्काइव डाउनलोड से अनपेक्षित प्रतिक्रिया मिली।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アーカイブのダウンロードで予期しない応答が返されました。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "存档下载返回了意外响应。" } }
      }
    },
    "The archive downloaded, but could not be prepared for sharing." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Archiv wurde heruntergeladen, konnte aber nicht zum Teilen vorbereitet werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El archivo se descargó, pero no pudo prepararse para compartirlo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’archive a été téléchargée, mais n’a pas pu être préparée pour le partage." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आर्काइव डाउनलोड हुआ, लेकिन शेयर करने के लिए तैयार नहीं किया जा सका।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アーカイブはダウンロードされましたが、共有用に準備できませんでした。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "存档已下载，但无法准备共享。" } }
      }
    },
    "Archive download failed with server status %@." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Archiv-Download ist mit dem Serverstatus %@ fehlgeschlagen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La descarga del archivo falló con el estado del servidor %@." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le téléchargement de l’archive a échoué avec le statut serveur %@." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सर्वर स्टेटस %@ के कारण आर्काइव डाउनलोड विफल हुआ।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サーバーステータス %@ によりアーカイブのダウンロードに失敗しました。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "存档下载失败，服务器状态为 %@。" } }
      }
    },
    "Privacy Policy\n\nYour data is completely under your control. We only store data locally by default. If you enable Cloud Sync, your rides are securely stored on our servers. You can permanently delete your synced data or your entire account at any time using the options below. Deleted data cannot be recovered." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Datenschutzrichtlinie\n\nDeine Daten bleiben vollständig unter deiner Kontrolle. Standardmäßig speichern wir Daten nur lokal. Wenn du die Cloud-Synchronisierung aktivierst, werden deine Fahrten sicher auf unseren Servern gespeichert. Du kannst synchronisierte Daten oder dein gesamtes Konto jederzeit mit den folgenden Optionen dauerhaft löschen. Gelöschte Daten können nicht wiederhergestellt werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Política de privacidad\n\nTus datos están completamente bajo tu control. De forma predeterminada, solo almacenamos datos localmente. Si activas la sincronización en la nube, tus recorridos se guardan de forma segura en nuestros servidores. Puedes eliminar permanentemente tus datos sincronizados o toda tu cuenta en cualquier momento con las opciones siguientes. Los datos eliminados no se pueden recuperar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Politique de confidentialité\n\nVous gardez le contrôle total de vos données. Par défaut, nous stockons les données uniquement en local. Si vous activez la synchronisation cloud, vos trajets sont stockés en toute sécurité sur nos serveurs. Vous pouvez supprimer définitivement vos données synchronisées ou votre compte entier à tout moment avec les options ci-dessous. Les données supprimées ne peuvent pas être récupérées." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "गोपनीयता नीति\n\nआपका डेटा पूरी तरह आपके नियंत्रण में है। डिफ़ॉल्ट रूप से हम डेटा केवल स्थानीय रूप से रखते हैं। यदि आप क्लाउड सिंक चालू करते हैं, तो आपकी राइड हमारे सर्वर पर सुरक्षित रूप से रखी जाती हैं। नीचे दिए विकल्पों से आप कभी भी अपना सिंक किया हुआ डेटा या पूरा खाता स्थायी रूप से हटा सकते हैं। हटाया गया डेटा वापस नहीं लाया जा सकता।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プライバシーポリシー\n\nデータはすべてあなたが管理します。デフォルトではデータを端末内にのみ保存します。クラウド同期を有効にすると、ライドはサーバーに安全に保存されます。以下のオプションから、同期済みデータまたはアカウント全体をいつでも完全に削除できます。削除したデータは復元できません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐私政策\n\n您的数据完全由您控制。默认情况下，我们只在本地存储数据。如果您启用云同步，您的骑行记录会安全地存储在我们的服务器上。您可以随时使用下面的选项永久删除已同步的数据或整个账户。删除的数据无法恢复。" } }
      }
    },
    "This feature uses advanced algorithms to clean up your raw GPS data immediately after a ride finishes.\n\n• Filters out GPS 'teleportation' glitches.\n• Smooths out noisy altitude and speed readings.\n• Detects when you were stopped and retroactively pauses the ride.\n• Compresses the total amount of data to save storage space." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Funktion bereinigt deine Roh-GPS-Daten direkt nach dem Ende einer Fahrt mit fortschrittlichen Algorithmen.\n\n• Filtert GPS-»Teleportations«-Fehler heraus.\n• Glättet verrauschte Höhen- und Geschwindigkeitswerte.\n• Erkennt Stopps und pausiert die Fahrt nachträglich.\n• Komprimiert die Datenmenge, um Speicherplatz zu sparen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta función usa algoritmos avanzados para limpiar tus datos GPS sin procesar justo después de terminar un recorrido.\n\n• Filtra los errores de «teletransporte» del GPS.\n• Suaviza las lecturas ruidosas de altitud y velocidad.\n• Detecta cuándo estabas detenido y pausa el recorrido retroactivamente.\n• Comprime la cantidad total de datos para ahorrar espacio." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette fonction utilise des algorithmes avancés pour nettoyer vos données GPS brutes dès la fin d’un trajet.\n\n• Filtre les anomalies de « téléportation » GPS.\n• Lisse les mesures bruitées d’altitude et de vitesse.\n• Détecte les arrêts et met le trajet en pause rétroactivement.\n• Compresse la quantité totale de données pour économiser de l’espace." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह सुविधा राइड पूरी होने के तुरंत बाद आपके कच्चे GPS डेटा को साफ़ करने के लिए उन्नत एल्गोरिदम का उपयोग करती है।\n\n• GPS की 'टेलीपोर्टेशन' गड़बड़ियां हटाती है।\n• शोर वाले ऊंचाई और गति रीडिंग को सुचारू बनाती है।\n• रुकने का पता लगाकर राइड को पीछे से रोकती है।\n• स्टोरेज बचाने के लिए कुल डेटा को संपीड़ित करती है।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この機能は高度なアルゴリズムを使い、ライド終了直後に生のGPSデータを整理します。\n\n• GPSの「テレポート」異常を除去します。\n• ノイズの多い高度と速度の値を滑らかにします。\n• 停止を検出してライドをさかのぼって一時停止します。\n• データ量を圧縮して保存容量を節約します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此功能会在骑行结束后立即使用高级算法清理原始 GPS 数据。\n\n• 过滤 GPS 的“瞬移”异常。\n• 平滑嘈杂的海拔和速度读数。\n• 检测停车并回溯暂停骑行。\n• 压缩数据总量以节省存储空间。" } }
      }
    },
    "When active, your location, speed, and battery level are shared securely.\n\n• Coordinates are pushed every %@.\n• Max concurrent viewers is determined by server capability (default: 100+ viewers).\n• Sharing automatically stops when the timer expires or you end your ride." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wenn aktiv, werden dein Standort, deine Geschwindigkeit und dein Akkustand sicher geteilt.\n\n• Koordinaten werden alle %@ übertragen.\n• Die maximale Zahl gleichzeitiger Zuschauer hängt von der Serverkapazität ab (Standard: über 100 Zuschauer).\n• Die Freigabe endet automatisch, wenn der Timer abläuft oder du die Fahrt beendest." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cuando está activa, tu ubicación, velocidad y nivel de batería se comparten de forma segura.\n\n• Las coordenadas se envían cada %@.\n• El máximo de espectadores simultáneos depende de la capacidad del servidor (predeterminado: más de 100 espectadores).\n• El uso compartido se detiene automáticamente cuando termina el temporizador o finalizas el recorrido." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Lorsqu’il est activé, votre position, votre vitesse et votre niveau de batterie sont partagés en toute sécurité.\n\n• Les coordonnées sont envoyées toutes les %@.\n• Le nombre maximal de spectateurs simultanés dépend de la capacité du serveur (par défaut : plus de 100 spectateurs).\n• Le partage s’arrête automatiquement à l’expiration du minuteur ou lorsque vous terminez votre trajet." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "चालू होने पर आपका स्थान, गति और बैटरी स्तर सुरक्षित रूप से शेयर किए जाते हैं।\n\n• निर्देशांक हर %@ पर भेजे जाते हैं।\n• एक साथ दर्शकों की अधिकतम संख्या सर्वर क्षमता पर निर्भर है (डिफ़ॉल्ट: 100+ दर्शक)।\n• टाइमर समाप्त होने या राइड खत्म करने पर शेयरिंग अपने आप बंद हो जाती है।" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "有効にすると、位置情報、速度、バッテリー残量が安全に共有されます。\n\n• 座標は %@ ごとに送信されます。\n• 同時閲覧者数の上限はサーバーの性能によって決まります（デフォルト：100人以上）。\n• タイマーの終了時またはライド終了時に共有は自動停止します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用后，您的位置、速度和电池电量会安全共享。\n\n• 坐标每 %@ 推送一次。\n• 最大同时查看人数取决于服务器能力（默认：100+ 人）。\n• 计时器到期或您结束骑行后，共享会自动停止。" } }
      }
    },
    "Cancel (%@)" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Abbrechen (%@)" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cancelar (%@)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Annuler (%@)" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "रद्द करें (%@)" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キャンセル (%@)" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消 (%@)" } }
      }
    }
  },
  "version" : "1.0"
}
