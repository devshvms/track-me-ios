    "Location access is turned off for TrackMe. Turn it on in Settings to record a ride — your route always stays on your device first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff ist für TrackMe deaktiviert. Aktiviere ihn in den Einstellungen, um eine Fahrt aufzuzeichnen – deine Route bleibt immer zuerst auf deinem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is turned off for TrackMe. Turn it on in Settings to record a ride — your route always stays on your device first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación está desactivado para TrackMe. Actívalo en Ajustes para registrar un recorrido; tu ruta siempre se guarda primero en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la position est désactivé pour TrackMe. Activez-le dans les Réglages pour enregistrer un trajet — votre itinéraire reste toujours sur votre appareil en premier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TrackMe के लिए स्थान तक पहुंच बंद है। राइड रिकॉर्ड करने के लिए इसे सेटिंग्स में चालू करें — आपका रूट हमेशा पहले आपके डिवाइस पर रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TrackMe の位置情報へのアクセスがオフになっています。ライドを記録するには、設定でオンにしてください。ルートは常にまずデバイス上に保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TrackMe 的位置访问权限已关闭。请在设置中开启以记录骑行——您的路线始终优先保留在设备上。"
          }
        }
      }
    },
    "Location access needed": {
