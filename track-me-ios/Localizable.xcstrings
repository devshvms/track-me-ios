    "Your ride reached 9,000 points and was split automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ride reached 9,000 points and was split automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Fahrt hat 9.000 Punkte erreicht und wurde automatisch geteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su viaje alcanzó los 9,000 puntos y se dividió automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre trajet a atteint 9 000 points et a été automatiquement scindé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सवारी 9,000 बिंदुओं तक पहुंच गई और स्वचालित रूप से विभाजित हो गई।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライドが9,000ポイントに達し、自動的に分割されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的骑行达到9,000个点并已自动拆分。"
          }
        }
      }
    },
