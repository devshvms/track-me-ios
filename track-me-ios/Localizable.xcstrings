    "Auto paused. You stopped moving; recording continues and distance is not counting.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch pausiert. Sie stehen still; die Aufzeichnung läuft weiter, die Distanz zählt nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa automática. Dejaste de moverte; la grabación continúa y la distancia no cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause automatique. Vous êtes immobile ; l’enregistrement continue et la distance ne compte pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतः रुका। आप चल नहीं रहे हैं; रिकॉर्डिंग जारी है और दूरी नहीं गिनी जा रही।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動一時停止中。移動していないため、記録は続きますが距離は加算されません。"
