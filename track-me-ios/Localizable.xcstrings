    "GPS uses power while a ride is recording. The ongoing notification confirms recording is active; auto-pause can reduce unnecessary work.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS verbraucht beim Aufzeichnen Energie. Die laufende Benachrichtigung bestätigt die Aktivität; automatische Pause spart Arbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS uses power while a ride is recording. The ongoing notification confirms recording is active; auto-pause can reduce unnecessary work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El GPS consume energía durante la grabación. La notificación indica que está activa; la pausa automática reduce trabajo innecesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS consomme de l'énergie pendant l'enregistrement. La notification confirme l'activité ; la pause automatique réduit le travail inutile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राइड रिकॉर्ड होने पर GPS बिजली लेता है। नोटिफिकेशन सक्रिय रिकॉर्डिंग दिखाता है; ऑटो-पॉज़ अनावश्यक काम घटाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライドの記録中はGPSが電力を使います。通知で記録中と確認でき、自動一時停止で不要な処理を減らせます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "骑行记录时 GPS 会耗电。持续通知表示正在记录；自动暂停可减少不必要的工作。"
          }
        }
      }
    },
